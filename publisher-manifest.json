p {border: 1px dashed #8a2230;padding: 22px;background: #fbf6ee}\n.faq-group h3 {font-size: 18px;color: #3d0d18;margin-bottom: 14px;letter-spacing: 1px;border-bottom: 1px dashed #c9a78f;padding-bottom: 8px}\n.faq-item {border-bottom: 1px dotted #d9c4ad;padding: 10px 0}\n.faq-item:last-child {border-bottom: none}\n.faq-item summary {cursor: pointer;font-size: 15px;color: #2a1a1f;font-weight: 600;padding: 4px 0;list-style: none;position: relative;padding-left: 22px}\n.faq-item summary::-webkit-details-marker {display: none}\n.faq-item summary::before {content: \"Q\";position: absolute;left: 0;top: 4px;background: #5a1320;color: #f5efe6;width: 18px;height: 18px;font-size: 11px;display: flex;align-items: center;justify-content: center;border-radius: 50%}\n.faq-item p {padding: 8px 0 4px 22px;color: #4a2a30;font-size: 14px;position: relative}\n.faq-item p::before {content: \"A\";position: absolute;left: 0;top: 8px;background: #fbf6ee;color: #8a2230;border: 1px dashed #8a2230;width: 18px;height: 18px;font-size: 11px;display: flex;align-items: center;justify-content: center;border-radius: 50%}\n\n/* 页脚 */\nfooter.foot {border-top: 1px dashed #8a2230;padding: 28px 0;margin-top: 40px;font-size: 13px;color: #7a3540;text-align: center;letter-spacing: 1px}\nfooter.foot .links {margin-bottom: 10px;display: flex;justify-content: center;flex-wrap: wrap;gap: 14px}\nfooter.foot .links a {color: #5a1320;text-decoration: none;border-bottom: 1px dashed #8a2230}\n\n/* 适配手机 */\n@media (max-width: 760px) {.hero h1 { font-size: 30px;}\n  .plans { grid-template-columns: 1fr;}\n  .plan { border-right: none;border-bottom: 1px dashed #c9a78f;}\n  .plan:last-child { border-bottom: none;}\n  .notes { grid-template-columns: 1fr;}\n  .note-card { border-right: none;}\n  .timeline li::before { left: -38px;width: 28px;height: 28px;font-size: 11px;}\n  .timeline { padding-left: 22px;}}\n</style><div class=\"brand-bar\">\n  <div class=\"wrap\">\n    <div class=\"name\">八 方 云</div>\n    <div class=\"motto\">BAFANG YUN · 阶梯订阅 · 节点流量</div>\n  </div>\n  <div class=\"wrap\">\n    <nav class=\"section-toc\" aria-label=\"区块目录\">\n      <a href=\"#flow\">服务流程</a>\n      <a href=\"#plans\">订阅计划</a>\n      <a href=\"#usage\">使用须知</a>\n      <a href=\"#faq\">常见问题</a>\n    </nav>\n  </div>\n</div>\n\n<main>\n  <section class=\"hero\">\n    <div class=\"wrap\">\n      <h1>八方云<br>把订阅当作一张<br>可逐级勾选的清单</h1>\n      <p class=\"lead\">从一台设备到二十台设备，从每月一百 GB 到一千 GB，八方云把节点流量、流媒体解锁与工单支持拆成三条阶梯，按月或按年勾选使用。</p>\n\n      <div class=\"timeline\" id=\"flow\">\n        <ol>\n          <li>\n            <h2>看清阶梯</h2>\n            <p>对照基础版、旗舰版、团队版三档，逐条核对每月流量、设备数与节点说明。</p>\n          </li>\n          <li>\n            <h2>勾选周期</h2>\n            <p>按月付灵活试，按年付一次性结算并在订阅页生成对应周期的票据凭证。</p>\n          </li>\n          <li>\n            <h2>配置客户端</h2>\n            <p>在订阅页查看与本档计划匹配的客户端说明，按指引完成导入与节点切换。</p>\n          </li>\n          <li>\n            <h2>反馈与升级</h2>\n            <p>使用中遇到问题提交工单，需要更多流量或设备时可在订阅页升级到上一阶梯。</p>\n          </li>\n        </ol>\n      </div>\n    </div>\n  </section>\n\n  <section class=\"block\" id=\"plans\">\n    <div class=\"wrap\">\n      <h2 class=\"section-title\">订阅计划</h2>\n      <p class=\"section-sub\">三档阶梯，逐级叠加流量、设备数与支持深度。</p>\n\n      <div class=\"plans\">\n        <article class=\"plan\">\n          <div class=\"step\">阶梯 01</div>\n          <h3>基础版</h3>\n          <div class=\"price\">¥15 <span>/ 月</span></div>\n          <div class=\"annual\">按年付仅需 ¥150 / 年</div>\n          <ul>\n            <li>每月 100GB 极速流量</li>\n            <li>支持 3 台设备同时在线</li>\n            <li>解锁基础流媒体</li>\n            <li>普通线路节点池</li>\n          </ul>\n          <div class=\"note\">适合单人轻度浏览与单设备测试。</div>\n        </article>\n\n        <article class=\"plan\">\n          <div class=\"tag\">推荐档</div>\n          <div class=\"step\">阶梯 02</div>\n          <h3>旗舰版</h3>\n          <div class=\"price\">¥35 <span>/ 月</span></div>\n          <div class=\"annual\">按年付仅需 ¥350 / 年</div>\n          <ul>\n            <li>每月 300GB 极速流量</li>\n            <li>支持 5 台设备同时在线</li>\n            <li>全节点原生流媒体解锁</li>\n            <li>IPLC 专线游戏加速优化</li>\n            <li>7×24 优先工单支持</li>\n          </ul>\n          <div class=\"note\">适合多设备家庭与高清流媒体使用。</div>\n        </article>\n\n        <article class=\"plan\">\n          <div class=\"step\">阶梯 03</div>\n          <h3>团队版</h3>\n          <div class=\"price\">¥85 <span>/ 月</span></div>\n          <div class=\"annual\">按年付仅需 ¥850 / 年</div>\n          <ul>\n            <li>每月 1000GB 极速流量</li>\n            <li>支持 20 台设备同时在线</li>\n            <li>VIP 专属高带宽节点</li>\n            <li>支持企业定制路由</li>\n            <li>专属客户经理服务</li>\n          </ul>\n          <div class=\"note\">适合工作室、团队办公与小微企业。</div>\n        </article>\n      </div>\n    </div>\n  </section>\n\n  <section class=\"block\" id=\"usage\">\n    <div class=\"wrap\">\n      <h2 class=\"section-title\">使用须知</h2>\n      <p class=\"section-sub\">把订阅、流量、设备与节点的关系讲清楚，再开始使用。</p>\n\n      <div class=\"notes\">\n        <div class=\"note-card\">\n          <h3>流量计费</h3>\n          <p>每月流量按自然月重置，未使用部分不结转至下一月；超过当月额度后可在订阅页升级到更高一档。</p>\n        </div>\n        <div class=\"note-card\">\n          <h3>设备同时在线</h3>\n          <p>设备数以同时在线的会话数计，超出后新会话会被提示，请关闭闲置会话或在订阅页升级阶梯。</p>\n        </div>\n        <div class=\"note-card\">\n          <h3>节点与流媒体</h3>\n          <p>基础版使用普通线路节点池；旗舰版可使用全节点原生流媒体解锁；团队版可使用 VIP 专属高带宽节点。</p>\n        </div>\n        <div class=\"note-card\">\n          <h3>周期与票据</h3>\n          <p>按月付每月生成一期票据，按年付一次性生成年度票据；票据仅供订阅内部核对，不作其他用途。</p>\n        </div>\n        <div class=\"note-card\">\n          <h3>升级与降级</h3>\n          <p>可在订阅页随时升级到更高一档；降级建议在当前周期结束后再处理，以避免当月额度与设备数临时回退。</p>\n        </div>\n        <div class=\"note-card\">\n          <h3>工单与客户经理</h3>\n          <p>基础版与旗舰版通过工单反馈，旗舰版享受优先处理；团队版另配专属客户经理，负责订阅变更与团队使用协调。</p>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  <section class=\"block\" id=\"faq\">\n    <div class=\"wrap\">\n      <h2 class=\"section-title\">常见问题</h2>\n      <p class=\"section-sub\">按主题归类，订阅、流量、设备与支持四项问题逐条作答。</p>\n\n      <div class=\"faq-groups\">\n\n        <div class=\"faq-group\">\n          <h3>订阅与周期</h3>\n\n          <details class=\"faq-item\">\n            <summary>按月付和按年付有什么区别？</summary>\n            <p>按月付每月出账一次，按年付一次性出账十二个月；按年付在订阅页生成对应周期的票据，便于一次核对。</p>\n          </details>\n\n          <details class=\"faq-item\">\n            <summary>中途可以从按月付切换到按年付吗？</summary>\n            <p>可以在订阅页申请切换，未消耗完的按月付周期在工单核对后折算到新的按年付周期中。</p>\n          </details>\n\n          <details class=\"faq-item\">\n            <summary>订阅到期后会自动续费吗？</summary>\n            <p>订阅到期前会在订阅页提示，续费由用户在订阅页手动确认，不会自动扣款。</p>\n          </details>\n        </div>\n\n        <div class=\"faq-group\">\n          <h3>流量与节点</h3>\n\n          <details class=\"faq-item\">\n            <summary>每月流量用完后还能继续使用吗？</summary>\n            <p>当月额度用完后，使用会被暂停；可在订阅页升级到更高一档继续使用，未使用流量不结转。</p>\n          </details>\n\n          <details class=\"faq-item\">\n            <summary>不同阶梯的节点差别在哪里？</summary>\n            <p>基础版使用普通线路节点池；旗舰版覆盖全节点原生流媒体解锁并提供 IPLC 专线；团队版在此基础上加入 VIP 专属高带宽节点。</p>\n          </details>\n\n          <details class=\"faq-item\">\n            <summary>流媒体解锁的范围如何确认？</summary>\n            <p>基础版只解锁基础流媒体；旗舰版说明为全节点原生流媒体解锁；具体可用清单以订阅页节点说明为准。</p>\n          </details>\n        </div>\n\n        <div class=\"faq-group\">\n          <h3>设备与客户端</h3>\n\n          <details class=\"faq-item\">\n            <summary>设备数是怎么计算的？</summary>\n            <p>设备数以同时在线的会话数计算，例如一台手机和一台电脑同时连接算作两个会话。</p>\n          </details>\n\n          <details class=\"faq-item\">\n            <summary>设备数用满后怎样扩容？</summary>\n            <p>可在订阅页升级到更高一档获得更多设备数；旗舰版为 5 台，团队版为 20 台。</p>\n          </details>\n\n          <details class=\"faq-item\">\n            <summary>客户端在哪里获取？</summary>\n            <p>客户端说明在订阅页提供，按所选阶梯显示对应版本与导入指引，请按指引完成配置。</p>\n          </details>\n        </div>\n\n        <div class=\"faq-group\">\n          <h3>支持与服务</h3>\n\n          <details class=\"faq-item\">\n            <summary>工单一般多久能得到回复？</summary>\n            <p>基础版与旗舰版均通过工单反馈，旗舰版享受 7×24 优先工单支持；团队版另配专属客户经理。</p>\n          </details>\n\n          <details class=\"faq-item\">\n            <summary>团队版的定制路由包含哪些内容？</summary>\n            <p>支持企业定制路由，由专属客户经理对接，按团队办公场景调整路由策略，具体内容在订阅页沟通确认。</p>\n          </details>\n\n          <details class=\"faq-item\">\n            <summary>如何升级或降级当前订阅？</summary>\n            <p>登录订阅页即可看到升级按钮，降级建议在当前周期结束后处理，以避免当月临时回退。</p>\n          </details>\n        </div>\n\n      </div>\n    </div>\n  </section>\n</main>\n\n<footer class=\"foot\">\n  <div class=\"wrap\">\n    <div class=\"links\">\n      <a href=\"#flow\">服务流程</a>\n      <a href=\"#plans\">订阅计划</a>\n      <a href=\"#usage\">使用须知</a>\n      <a href=\"#faq\">常见问题</a>\n    </div>\n    <div>八方云 · BAFANG YUN · 阶梯订阅节点流量服务</div>\n  </div>\n</footer>",
